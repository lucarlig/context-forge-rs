  "name": "context-forge-reference-server",
  "run": [
    "context-forge-reference-server"
  ],
  "normalize": [
    "key-order"
  ],
  "normalizers": {
    "runtime": "^(python|rust)$"
  },
  "timeout_secs": 30,
