{
  "schema": "rust-anything/app-cases@1",
  "name": "context-forge-rs",
  "run": [
    "context-forge-export-reference"
  ],
  "normalize": [
    "key-order"
  ],
  "normalizers": {
    "export-port": "http://127\\.0\\.0\\.1:[0-9]+",
    "export-time": "20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z"
  },
  "timeout_secs": 30,
  "http": {},
  "recorded": [
    "export-administrator",
    "export-default-roots-denied",
    "export-filtered",
    "export-inactive",
    "export-no-types",
    "export-public",
    "export-selective-empty-roots",
    "export-selective-public",
    "export-selective-root-denied",
    "export-selective-team",
    "export-team",
    "export-token-permission-denied",
    "export-unauthenticated",
    "export-viewer-denied"
  ]
}
